# Gemini API Configuration
# Put your Gemini API Key below
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (Check official Google GenAI docs for active model names)
# Recommended: gemini-2.5-flash or gemini-1.5-flash
MODEL_NAME=gemini-2.5-flash

# Scraper Settings
APP_ID=com.moveinsync.ets
DAYS_HISTORY=180

# Daily AI Budget Guardrails (Protects against 429 quota exhaustion)
MAX_REQUESTS_PER_DAY=16
REVIEWS_PER_REQUEST=40
REQUEST_DELAY_SECONDS=6
MAX_RETRIES=2

# Development / Offline Mock AI mode (set to true to test without calling LLM)
USE_MOCK_AI=false
